<?xml version="1.0"?>
<!--
  Lightweight top-down model for Foxglove.

  The full simulation URDF contains rotating wheel cylinders and collision
  spheres.  Some Foxglove Web versions render those primitives at an
  incorrect scale, which can cover the occupancy map with a large blue disk.
  This model intentionally uses only visual boxes plus one small lidar
  cylinder, all attached to base_link, so it follows the real TF without
  changing the robot's navigation geometry.
-->
<robot name="hcrobot_foxglove">
  <material name="body_orange">
    <color rgba="1.0 0.30 0.05 1.0"/>
  </material>
  <material name="front_red">
    <color rgba="0.90 0.05 0.05 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <link name="base_link">
    <visual name="body">
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.16"/>
      </geometry>
      <material name="body_orange"/>
    </visual>

    <!-- The red nose makes the +X/forward direction obvious in 2D view. -->
    <visual name="front_direction">
      <origin xyz="0.225 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.14 0.06"/>
      </geometry>
      <material name="front_red"/>
    </visual>

    <visual name="left_wheel">
      <origin xyz="0 0.17 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.04 0.08"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <visual name="right_wheel">
      <origin xyz="0 -0.17 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.04 0.08"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <visual name="lidar">
      <origin xyz="0.08 0 0.19" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.04"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>
</robot>
