<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- World KHEP KIN de test tu kham pha (Nav2 + frontier) va quet map.
       Mat bang 8 x 6 m, 3 phong noi bang cua rong 1.2 m:

         y=6 +---------------------+-----------------+
             |                     |  PHONG B (tren) |
             |                   cua 2              |
             |     PHONG A       +----------------- + y=3
             |     (trai)          |                 |
             |   [xe xuat phat]  cua 1  PHONG C (duoi)
         y=0 +---------------------+-----------------+
            x=0                  x=4.5              x=8

       Chay:  EXPLORE=1 EXPLORE_SAVE=explore_room WORLD=$PWD/robot/worlds/explore_room.world \
                GZ_GUI=1 bash robot/ros2_configs/start_sim_foxglove.sh -->
  <world name="explore_room">
    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.80 0.84 0.88 1.0</background>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.65 0.65 0.65</ambient_light>
        <background_color>0.80 0.84 0.88</background_color>
        <!-- Nhin xuong toan bo mat bang tu phia nam -->
        <camera_pose>4.0 -4.5 7.5 0 0.95 1.5708</camera_pose>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property key="height" type="double">72</property>
          <property key="z" type="double">1</property>
          <property key="state" type="string">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property key="height" type="double">110</property>
          <property key="width" type="double">290</property>
          <property key="z" type="double">1</property>
          <property key="state" type="string">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- Ve tia LiDAR: chon topic /scan (GUI phai mo sau server, script da lo) -->
      <plugin filename="VisualizeLidar" name="Visualize Lidar">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <plugin filename="Teleop" name="Teleop">
        <gz-gui>
          <title>Teleop</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <topic>/cmd_vel</topic>
      </plugin>
    </gui>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>4 3 20 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ TUONG (cao 0.5 m, day 0.1 m) ============ -->
    <model name="walls">
      <static>true</static>

      <!-- Tuong bao ngoai -->
      <link name="wall_south">
        <pose>4.0 0.0 0.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>8.1 0.1 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.30 0.32 0.36 1</ambient><diffuse>0.30 0.32 0.36 1</diffuse></material></visual>
      </link>
      <link name="wall_north">
        <pose>4.0 6.0 0.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>8.1 0.1 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.30 0.32 0.36 1</ambient><diffuse>0.30 0.32 0.36 1</diffuse></material></visual>
      </link>
      <link name="wall_west">
        <pose>0.0 3.0 0.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.1 6.1 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 6.1 0.5</size></box></geometry>
          <material><ambient>0.30 0.32 0.36 1</ambient><diffuse>0.30 0.32 0.36 1</diffuse></material></visual>
      </link>
      <link name="wall_east">
        <pose>8.0 3.0 0.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.1 6.1 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 6.1 0.5</size></box></geometry>
          <material><ambient>0.30 0.32 0.36 1</ambient><diffuse>0.30 0.32 0.36 1</diffuse></material></visual>
      </link>

      <!-- Vach doc x=4.5, chia phong A voi B/C. Cua 1: y=1.0..2.2, cua 2: y=4.0..5.2 -->
      <link name="partition_1">
        <pose>4.5 0.5 0.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.1 1.0 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 1.0 0.5</size></box></geometry>
          <material><ambient>0.45 0.47 0.52 1</ambient><diffuse>0.45 0.47 0.52 1</diffuse></material></visual>
      </link>
      <link name="partition_2">
        <pose>4.5 3.1 0.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.1 1.8 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 1.8 0.5</size></box></geometry>
          <material><ambient>0.45 0.47 0.52 1</ambient><diffuse>0.45 0.47 0.52 1</diffuse></material></visual>
      </link>
      <link name="partition_3">
        <pose>4.5 5.6 0.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.1 0.8 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 0.8 0.5</size></box></geometry>
          <material><ambient>0.45 0.47 0.52 1</ambient><diffuse>0.45 0.47 0.52 1</diffuse></material></visual>
      </link>

      <!-- Vach ngang y=3, chia phong B (tren) va C (duoi), kin hoan toan -->
      <link name="partition_bc">
        <pose>6.25 3.0 0.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>3.5 0.1 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.5 0.1 0.5</size></box></geometry>
          <material><ambient>0.45 0.47 0.52 1</ambient><diffuse>0.45 0.47 0.52 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ VAT CAN ============ -->
    <!-- Phong A -->
    <include><uri>model://construction_barrel</uri><name>barrel_a</name><pose>2.6 4.4 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_a1</name><pose>1.0 4.2 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_a2</name><pose>3.0 2.0 0 0 0 0</pose></include>
    <!-- Phong C (duoi phai) -->
    <include><uri>model://traffic_cone</uri><name>cone_c1</name><pose>6.4 1.2 0 0 0 0</pose></include>
    <include><uri>model://construction_barrel</uri><name>barrel_c</name><pose>7.3 2.3 0 0 0 0</pose></include>
    <!-- Phong B (tren phai) -->
    <include><uri>model://traffic_cone</uri><name>cone_b1</name><pose>6.0 4.4 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_b2</name><pose>7.2 5.3 0 0 0 0</pose></include>

    <!-- ============ ROBOT (phong A, goc duoi trai, mui huong +X) ============ -->
    <include>
      <uri>model://hc_robot</uri>
      <name>hc_robot</name>
      <pose>1.2 1.2 0.03 0 0 0</pose>
    </include>
  </world>
</sdf>
