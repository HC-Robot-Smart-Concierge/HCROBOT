<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="hotel_lobby_world">
    <!-- Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Native Gazebo GUI with docked 3D LiDAR Visualizer -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.82 0.82 0.85</background_color>
        <camera_pose>-5.5 0 5.5 0 0.6 0</camera_pose>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- LiDAR 360 Rays Visualizer in Gazebo -->
      <plugin filename="VisualizeLidar" name="Visualize Lidar">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Ground Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.82 0.85 0.88 1</ambient>
            <diffuse>0.82 0.85 0.88 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- EXPANDED ARENA WALLS (8m x 6m x 1.2m)                    -->
    <!-- ======================================================== -->
    <model name="arena_walls">
      <static>true</static>
      
      <!-- Arena Floor Tile (Sleek Dark Modern Gray Floor) -->
      <link name="arena_floor">
        <visual name="floor_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <box><size>8.0 6.0 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.70 0.72 0.75 1</ambient>
            <diffuse>0.70 0.72 0.75 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>

      <!-- North Wall (Top) -->
      <link name="wall_north">
        <pose>0.0 3.0 0.6 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>8.6 0.30 1.2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>8.6 0.30 1.2</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.2 0.2 0.22 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- South Wall (Bottom) -->
      <link name="wall_south">
        <pose>0.0 -3.0 0.6 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>8.6 0.30 1.2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>8.6 0.30 1.2</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.2 0.2 0.22 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- East Wall (Right) -->
      <link name="wall_east">
        <pose>4.0 0.0 0.6 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.30 6.6 1.2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.30 6.6 1.2</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.2 0.2 0.22 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- West Wall (Left) -->
      <link name="wall_west">
        <pose>-4.0 0.0 0.6 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.30 6.6 1.2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.30 6.6 1.2</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.2 0.2 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- WHITE CYLINDRICAL OBSTACLES (AS SEEN IN PICTURE 3)       -->
    <!-- ======================================================== -->

    <!-- Center Pillar 1 (0, 0) -->
    <model name="pillar_center">
      <static>true</static>
      <pose>0.0 0.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.40</radius><length>0.90</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.40</radius><length>0.90</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.7 0.7 0.7 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar 2 (1.8, 1.2) -->
    <model name="pillar_northeast">
      <static>true</static>
      <pose>1.8 1.2 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.35</radius><length>0.90</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.35</radius><length>0.90</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.7 0.7 0.7 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar 3 (1.8, -1.2) -->
    <model name="pillar_southeast">
      <static>true</static>
      <pose>1.8 -1.2 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.35</radius><length>0.90</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.35</radius><length>0.90</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.7 0.7 0.7 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar 4 (-1.8, 1.2) -->
    <model name="pillar_northwest">
      <static>true</static>
      <pose>-1.8 1.2 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.35</radius><length>0.90</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.35</radius><length>0.90</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.7 0.7 0.7 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar 5 (-1.8, -1.2) -->
    <model name="pillar_southwest">
      <static>true</static>
      <pose>-1.8 -1.2 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.35</radius><length>0.90</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.35</radius><length>0.90</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.7 0.7 0.7 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar 6 (0.0, -1.8) -->
    <model name="pillar_south">
      <static>true</static>
      <pose>0.0 -1.8 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.35</radius><length>0.90</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.35</radius><length>0.90</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.7 0.7 0.7 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robot Docking Station (Green Base at Top Left) -->
    <model name="robot_docking_station">
      <static>true</static>
      <pose>-3.2 1.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.6 0.6 0.01</size></box></geometry>
          <material>
            <ambient>0.1 0.85 0.3 1</ambient>
            <diffuse>0.1 0.85 0.3 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- ROBOT HC-ROBOT MODEL                                     -->
    <!-- ======================================================== -->
    <include>
      <uri>model://hc_robot</uri>
      <name>hc_robot</name>
      <pose>-3.0 1.5 0.04 0 0 0</pose>
    </include>

  </world>
</sdf>
