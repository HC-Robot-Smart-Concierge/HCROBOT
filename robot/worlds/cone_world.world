<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- World test LiDAR: san trong co luoi, coc giao thong + thung phuy rai quanh xe.
       Chay:  WORLD=$PWD/robot/worlds/cone_world.world GZ_GUI=1 bash robot/ros2_configs/start_sim_foxglove.sh
       Xem tia LiDAR trong Gazebo: panel "Visualize Lidar" -> chon topic /scan -> bam Refresh. -->
  <world name="cone_world">
    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.80 0.84 0.88 1.0</background>
      <grid>true</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.65 0.65 0.65</ambient_light>
        <background_color>0.80 0.84 0.88</background_color>
        <!-- Nhin cheo tu sau-trai xe, giong goc chup trong anh -->
        <camera_pose>-3.2 3.2 2.6 0 0.50 -0.785</camera_pose>
      </plugin>

      <!-- Luoi o vuong 1 m tren san -->
      <plugin filename="GridConfig" name="Grid config">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
        </gz-gui>
        <insert>
          <horizontal_cell_count>30</horizontal_cell_count>
          <vertical_cell_count>0</vertical_cell_count>
          <cell_length>1.0</cell_length>
          <pose>0 0 0.002 0 0 0</pose>
          <color>0.55 0.55 0.55 1</color>
        </insert>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property key="height" type="double">72</property>
          <property key="z" type="double">1</property>
          <property key="state" type="string">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property key="height" type="double">110</property>
          <property key="width" type="double">290</property>
          <property key="z" type="double">1</property>
          <property key="state" type="string">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- Ve tia LiDAR: chon topic /scan trong panel nay. Chi dung vi tri khi GUI
           mo SAU server (start_sim_foxglove.sh da lo); neu mo GUI cung luc voi
           server, tia se bi ve o goc toa do (0,0,0). -->
      <plugin filename="VisualizeLidar" name="Visualize Lidar">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <plugin filename="Teleop" name="Teleop">
        <gz-gui>
          <title>Teleop</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <topic>/cmd_vel</topic>
      </plugin>
    </gui>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>

    <!-- San xam nhat -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== COC GIAO THONG ===================== -->
    <!-- Hang coc phia truoc-phai xe (giong hang coc o goc duoi anh) -->
    <include><uri>model://traffic_cone</uri><name>cone_1</name><pose>1.6 -1.2 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_2</name><pose>2.4 -1.8 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_3</name><pose>3.2 -2.3 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_4</name><pose>1.0 -2.4 0 0 0 0</pose></include>

    <!-- Coc phia sau-trai xe -->
    <include><uri>model://traffic_cone</uri><name>cone_5</name><pose>-1.4 1.0 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_6</name><pose>-2.3 0.3 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_7</name><pose>-1.8 -1.6 0 0 0 0</pose></include>

    <!-- Coc rai rac xa hon -->
    <include><uri>model://traffic_cone</uri><name>cone_8</name><pose>2.8 1.4 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_9</name><pose>0.4 2.6 0 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_10</name><pose>4.2 0.2 0 0 0 0</pose></include>

    <!-- ===================== THUNG PHUY ===================== -->
    <include><uri>model://construction_barrel</uri><name>barrel_1</name><pose>1.5 1.6 0 0 0 0</pose></include>
    <include><uri>model://construction_barrel</uri><name>barrel_2</name><pose>-2.6 -2.4 0 0 0 0</pose></include>
    <include><uri>model://construction_barrel</uri><name>barrel_3</name><pose>-0.6 -3.0 0 0 0 0</pose></include>

    <!-- ===================== ROBOT ===================== -->
    <!-- Xe o goc toa do, mui huong +X -->
    <include>
      <uri>model://hc_robot</uri>
      <name>hc_robot</name>
      <pose>0 0 0.03 0 0 0</pose>
    </include>
  </world>
</sdf>
