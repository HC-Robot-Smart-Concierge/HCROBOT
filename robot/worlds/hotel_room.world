    <!-- ======================================================== -->
    <!-- 13. CAC DIEM DICH DEN / ENDPOINTS (WAYPOINT 3D BEACONS)   -->
    <!-- Toan bo diem cung loai thi cung mau:                      -->
    <!-- - PARK (Standby): Amber Vang Cam (0.96, 0.62, 0.04)       -->
    <!-- - CHARGER (Tram Sac): Emerald Xanh La (0.06, 0.72, 0.50)  -->
    <!-- - WAYPOINT (Diem Moc): Royal Blue Xanh Duong (0.15, 0.45, 0.95) -->
    <!-- Cac diem duoc to chuc thanh MODEL rieng de cho phep       -->
    <!-- set_pose thoi gian thuc tu Web Admin                      -->
    <!-- ======================================================== -->

    <!-- Waypoint 1: Vi Tri Cho Robot Sanh (ROBOT_STANDBY - PARK: Amber) -->
    <model name="wp_marker_standby">
      <static>true</static>
      <pose>4.56 11.98 0.01 0 0 0</pose>
      <link name="link">
        <visual name="floor_ring">
          <geometry><cylinder><radius>0.40</radius><length>0.005</length></cylinder></geometry>
