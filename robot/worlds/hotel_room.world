<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="hotel_lobby_world">
    <!-- Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Native Gazebo GUI with docked 3D LiDAR Visualizer -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.55 0.55</ambient_light>
        <background_color>0.85 0.87 0.90</background_color>
        <!-- Isometric view from south entrance overlooking entire 10m x 6m lobby -->
        <camera_pose>5.0 -3.5 8.5 0 0.90 1.5708</camera_pose>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- LiDAR 360 Rays Visualizer in Gazebo -->
      <plugin filename="VisualizeLidar" name="Visualize Lidar">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>5 3 15 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.82 0.84 0.86 1</ambient>
            <diffuse>0.82 0.84 0.86 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- HOTEL LOBBY ARCHITECTURE (10m x 6m - GROUND FLOOR)       -->
    <!-- DONG BO 100% VOI SO DO MAT BANG SANH TREN WEB            -->
    <!-- ======================================================== -->
    <model name="hotel_lobby_architecture">
      <static>true</static>

      <!-- 1. SAN SANH KHACH SAN (Tiled Lobby Floor: 10m x 6m) -->
      <link name="lobby_floor">
        <pose>5.0 3.0 0.005 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>10.0 6.0 0.01</size></box></geometry>
          <material>
            <ambient>0.90 0.89 0.86 1</ambient>
            <diffuse>0.90 0.89 0.86 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>



      <!-- 3. TUONG BAO NGOAI (OUTER WALLS: Cao 1.4m, Day 0.2m) -->
      <!-- Tuong Tay (West Wall: x = 0.0) -->
      <link name="wall_west">
        <pose>0.0 3.0 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 6.0 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 6.0 1.4</size></box></geometry>
          <material><ambient>0.22 0.22 0.24 1</ambient><diffuse>0.22 0.22 0.24 1</diffuse></material>
        </visual>
      </link>

      <!-- Tuong Dong (East Wall: x = 10.0) -->
      <link name="wall_east">
        <pose>10.0 3.0 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 6.0 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 6.0 1.4</size></box></geometry>
          <material><ambient>0.22 0.22 0.24 1</ambient><diffuse>0.22 0.22 0.24 1</diffuse></material>
        </visual>
      </link>

      <!-- Tuong Bac (North Wall: y = 6.0) -->
      <link name="wall_north">
        <pose>5.0 6.0 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>10.2 0.2 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10.2 0.2 1.4</size></box></geometry>
          <material><ambient>0.22 0.22 0.24 1</ambient><diffuse>0.22 0.22 0.24 1</diffuse></material>
        </visual>
      </link>

      <!-- Tuong Nam Tay (South-West: x = 0.0 -> 4.8) -->
      <link name="wall_south_west">
        <pose>2.4 0.0 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>4.8 0.2 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.8 0.2 1.4</size></box></geometry>
          <material><ambient>0.22 0.22 0.24 1</ambient><diffuse>0.22 0.22 0.24 1</diffuse></material>
        </visual>
      </link>

      <!-- Cua Chinh Ra Vao Sanh (Main Entrance Welcome Mat: x = 4.8 -> 5.8) -->
      <link name="entrance_mat">
        <pose>5.3 0.0 0.015 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>1.0 0.4 0.01</size></box></geometry>
          <material><ambient>0.3 0.45 0.65 1</ambient><diffuse>0.3 0.45 0.65 1</diffuse></material>
        </visual>
      </link>

      <!-- Tuong Nam Dong (South-East: x = 5.8 -> 10.0) -->
      <link name="wall_south_east">
        <pose>7.9 0.0 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>4.2 0.2 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.2 0.2 1.4</size></box></geometry>
          <material><ambient>0.22 0.22 0.24 1</ambient><diffuse>0.22 0.22 0.24 1</diffuse></material>
        </visual>
      </link>

      <!-- 4. VACH NGAN CHIA 2 GIAN (CENTRAL PARTITION WALL: x = 4.4) -->
      <!-- Vach Ngan Bac (y = 3.3 -> 6.0) -->
      <link name="partition_north">
        <pose>4.4 4.65 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 2.7 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 2.7 1.4</size></box></geometry>
          <material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse></material>
        </visual>
      </link>

      <!-- Vach Ngan Nam (y = 0.0 -> 2.4) -->
      <link name="partition_south">
        <pose>4.4 1.2 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 2.4 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 2.4 1.4</size></box></geometry>
          <material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse></material>
        </visual>
      </link>
      <!-- Luu y: Khoang giua y = 2.4 -> 3.3 la Cua thong sanh (Doorway) rong 0.9m de Robot luu thong tu do -->

      <!-- 5. GIAN TRAI: 3 BO GHE SOFA VA BAN TRA (LOBBY LOUNGE) -->
      <!-- Bo Sofa 1 (Bac) -->
      <link name="sofa_north">
        <pose>0.55 5.0 0.35 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.6 1.4 0.7</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.6 1.4 0.7</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
      </link>
      <link name="table_north">
        <pose>1.3 5.0 0.22 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.25</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>0.44</length></cylinder></geometry>
          <material><ambient>0.75 0.65 0.55 1</ambient><diffuse>0.75 0.65 0.55 1</diffuse></material>
        </visual>
      </link>

      <!-- Bo Sofa 2 (Giua) -->
      <link name="sofa_center">
        <pose>0.55 3.0 0.35 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.6 1.4 0.7</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.6 1.4 0.7</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
      </link>
      <link name="table_center">
        <pose>1.3 3.0 0.22 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.25</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>0.44</length></cylinder></geometry>
          <material><ambient>0.75 0.65 0.55 1</ambient><diffuse>0.75 0.65 0.55 1</diffuse></material>
        </visual>
      </link>

      <!-- Bo Sofa 3 (Nam) -->
      <link name="sofa_south">
        <pose>0.55 1.0 0.35 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.6 1.4 0.7</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.6 1.4 0.7</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
      </link>
      <link name="table_south">
        <pose>1.3 1.0 0.22 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.25</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>0.44</length></cylinder></geometry>
          <material><ambient>0.75 0.65 0.55 1</ambient><diffuse>0.75 0.65 0.55 1</diffuse></material>
        </visual>
      </link>

      <!-- 6. GIAN PHAI: QUAY LE TAN (FRONT DESK COUNTER) -->
      <!-- Mat truoc quay Tiep Tan -->
      <link name="front_desk_main">
        <pose>6.3 2.5 0.52 0 0 0</pose>
        <collision name="col"><geometry><box><size>1.0 0.35 1.05</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.0 0.35 1.05</size></box></geometry>
          <material><ambient>0.65 0.45 0.30 1</ambient><diffuse>0.65 0.45 0.30 1</diffuse></material>
        </visual>
      </link>
      <!-- Vach ben hong quay Tiep Tan -->
      <link name="front_desk_side">
        <pose>5.8 1.4 0.52 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.25 2.2 1.05</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.25 2.2 1.05</size></box></geometry>
          <material><ambient>0.65 0.45 0.30 1</ambient><diffuse>0.65 0.45 0.30 1</diffuse></material>
        </visual>
      </link>

      <!-- 7. GIAN PHAI: PHONG NHAN VIEN (STAFF ONLY ROOM) -->
      <!-- Vach doc phong Staff -->
      <link name="staff_wall_v">
        <pose>7.7 1.3 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 2.6 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 2.6 1.4</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
      </link>
      <!-- Vach ngang phong Staff -->
      <link name="staff_wall_h">
        <pose>8.85 2.6 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>2.3 0.15 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.3 0.15 1.4</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
      </link>

      <!-- 8. DAY TIEN ICH PHIA BAC (RESTROOMS, ELEVATORS, STAIRS) -->
      <!-- Tuong phia Tay cua Nha Ve Sinh (West Wall of Restrooms: x = 5.8, y = 4.7 -> 6.0) -->
      <link name="restroom_wall_west">
        <pose>5.8 5.35 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 1.3 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 1.3 1.4</size></box></geometry>
          <material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse></material>
        </visual>
      </link>

      <!-- Tuong mat truoc Nha Ve Sinh (ben trai cua vao: x = 5.8 -> 6.3) -->
      <link name="restroom_front_w">
        <pose>6.05 4.7 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.5 0.15 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.15 1.4</size></box></geometry>
          <material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse></material>
        </visual>
      </link>

      <!-- Tuong mat truoc Nha Ve Sinh (ben phai cua vao: x = 6.7 -> 7.2) -->
      <link name="restroom_front_e">
        <pose>6.95 4.7 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.5 0.15 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.15 1.4</size></box></geometry>
          <material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse></material>
        </visual>
      </link>

      <!-- Vach ngan chia 2 buong Nam / Nu ben trong WC -->
      <link name="restroom_inner_partition">
        <pose>6.5 5.5 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.12 1.0 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.12 1.0 1.4</size></box></geometry>
          <material><ambient>0.40 0.40 0.42 1</ambient><diffuse>0.40 0.40 0.42 1</diffuse></material>
        </visual>
      </link>

      <!-- Vach chia giua Nha Ve Sinh va Cum Thang May (x = 7.2) -->
      <link name="restroom_div">
        <pose>7.2 5.35 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 1.3 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 1.3 1.4</size></box></geometry>
          <material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse></material>
        </visual>
      </link>

      <!-- Vach ngan giua Cum Thang May va Cau Thang Bo (x = 8.6) -->
      <link name="elevator_stairs_div">
        <pose>8.65 5.35 0.7 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 1.3 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 1.3 1.4</size></box></geometry>
          <material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse></material>
        </visual>
      </link>

      <!-- Cum 2 Thang May (Elevator Cabins) -->
      <link name="elevator_cabin_1">
        <pose>7.6 5.4 1.1 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.6 1.0 2.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.6 1.0 2.2</size></box></geometry>
          <material><ambient>0.45 0.50 0.55 1</ambient><diffuse>0.45 0.50 0.55 1</diffuse><specular>0.7 0.7 0.7 1</specular></material>
        </visual>
      </link>
      <link name="elevator_cabin_2">
        <pose>8.3 5.4 1.1 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.6 1.0 2.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.6 1.0 2.2</size></box></geometry>
          <material><ambient>0.45 0.50 0.55 1</ambient><diffuse>0.45 0.50 0.55 1</diffuse><specular>0.7 0.7 0.7 1</specular></material>
        </visual>
      </link>

      <!-- Cau Thang Bo (Stairs Block) -->
      <link name="stairs_block">
        <pose>9.15 5.35 0.6 0 0 0</pose>
        <collision name="col"><geometry><box><size>1.3 1.3 1.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.3 1.3 1.2</size></box></geometry>
          <material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.50 0.52 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- ROBOT HC-ROBOT MODEL                                     -->
    <!-- Dat tai Goc Tren Ben Phai Lobby: X=3.7, Y=5.0            -->
    <!-- ======================================================== -->
    <include>
      <uri>model://hc_robot</uri>
      <name>hc_robot</name>
      <pose>3.7 5.0 0.04 0 0 -1.5708</pose>
    </include>

  </world>
</sdf>
