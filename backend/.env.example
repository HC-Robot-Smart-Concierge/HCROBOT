# Supabase PostgreSQL Cloud Configuration (IPv4 Connection Pooler)
POSTGRES_USER=postgres.your_project_ref
POSTGRES_PASSWORD=your_supabase_password
POSTGRES_HOST=aws-0-ap-northeast-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# SQLAlchemy Async Connection String (password must be URL-encoded)
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_encoded_password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ChromaDB Vector Store & Obsidian Vault Directory
CHROMA_PERSIST_DIR=./chroma_db
OBSIDIAN_VAULT_DIR=./knowledge_vault

# Ollama Local Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=bge-m3

# Raspberry Pi Configuration
ROBOT_PI_IP=pi5
PI_CAMERA_SOURCE=http://pi5:8080/stream

# AI Voice Configuration
TTS_PROVIDER=edge
