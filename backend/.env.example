# ============================================================
# HC-ROBOT CENTRAL BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# 1. PostgreSQL Database Configuration
# Local PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hc_robot_db
DATABASE_URL=postgresql+asyncpg://postgres:your_local_password@localhost:5432/hc_robot_db

# Supabase PostgreSQL Cloud Configuration (IPv4 Connection Pooler)
# POSTGRES_USER=postgres.your_project_ref
# POSTGRES_PASSWORD=your_supabase_password
# POSTGRES_HOST=aws-0-ap-northeast-1.pooler.supabase.com
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_encoded_password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# 2. ChromaDB Vector Store & Obsidian Knowledge Vault
CHROMA_PERSIST_DIR=./chroma_db
OBSIDIAN_VAULT_DIR=./knowledge_vault

# 3. Ollama AI Local LLM (Mặc định cho toàn bộ dự án) & Groq Cloud (Tùy chọn cho máy yếu test)
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=bge-m3
# Tùy chọn test máy yếu (Không ngốn RAM): Đặt AI_PROVIDER=groq và điền GROQ_API_KEY (lấy miễn phí tại console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 4. Text-To-Speech (TTS) Voice Synthesis
# Các tùy chọn TTS_PROVIDER: 'edge' (mặc định miễn phí), 'elevenlabs', 'openai', 'browser'
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=
OPENAI_TTS_VOICE=alloy

# 5. Pipecat Realtime Audio Pipeline (Low Latency WebSocket)
ENABLE_PIPECAT=True
PIPECAT_SAMPLE_RATE=16000

# 6. Robot Hardware Integration (Raspberry Pi 5)
ROBOT_PI_IP=pi5
PI_CAMERA_SOURCE=http://pi5:8080/stream

# 7. Cloudinary Video Call Recording Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hcrobot/call_recordings
