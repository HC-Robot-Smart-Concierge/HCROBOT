<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- Coc giao thong: de vuong den + than "non" ghep tu cac khuc tru nho dan,
       soc cam/trang xen ke. Cao tong 0.70 m. Dung tru thay vi <cone> de chay
       duoc tren moi phien ban gz sim. -->
  <model name="traffic_cone">
    <static>true</static>
    <link name="link">

      <!-- Va cham: 1 khoi tru gan dung voi than coc -->
      <collision name="col_base">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry><box><size>0.38 0.38 0.03</size></box></geometry>
      </collision>
      <collision name="col_body">
        <pose>0 0 0.36 0 0 0</pose>
        <geometry><cylinder><radius>0.10</radius><length>0.66</length></cylinder></geometry>
      </collision>

      <!-- De vuong mau den -->
      <visual name="base">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry><box><size>0.38 0.38 0.03</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>

      <!-- Than coc: 5 khuc, tu duoi len -->
      <visual name="seg1_orange">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.18</length></cylinder></geometry>
        <material>
          <ambient>1.0 0.35 0.0 1</ambient>
          <diffuse>1.0 0.35 0.0 1</diffuse>
        </material>
      </visual>
      <visual name="seg2_white">
        <pose>0 0 0.27 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.12</length></cylinder></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
        </material>
      </visual>
      <visual name="seg3_orange">
        <pose>0 0 0.40 0 0 0</pose>
        <geometry><cylinder><radius>0.095</radius><length>0.14</length></cylinder></geometry>
        <material>
          <ambient>1.0 0.35 0.0 1</ambient>
          <diffuse>1.0 0.35 0.0 1</diffuse>
        </material>
      </visual>
      <visual name="seg4_white">
        <pose>0 0 0.52 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.10</length></cylinder></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
        </material>
      </visual>
      <visual name="seg5_orange">
        <pose>0 0 0.63 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.14</length></cylinder></geometry>
        <material>
          <ambient>1.0 0.35 0.0 1</ambient>
          <diffuse>1.0 0.35 0.0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
