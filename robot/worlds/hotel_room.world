      <static>true</static>
      <pose>0.00 0.00 -10.00 0 0 0</pose>
      <link name="link">
        <visual name="floor_ring">
          <geometry><cylinder><radius>0.40</radius><length>0.005</length></cylinder></geometry>
          <material>
            <ambient>0.20 0.83 0.60 0.9</ambient>
